# See https://help.github.com/articles/ignoring-files/

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
/playwright-report/
/test-results/

# Next.js
/.next/
/out/
next-env.d.ts

# Production builds
/build
/dist

# Environment variables and secrets
.env*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Private keys and credentials
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
credentials*.json
service-account*.json

# Local databases and private data
*.sqlite
*.sqlite3
*.db
*.db-journal
*.bak
*.backup

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/tmp/
/temp/

# Build caches
/.turbo/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo

# Miscellaneous OS files
.DS_Store
Thumbs.db

# Keep local environment files and credentials private
.env*
!.env.example
!.env.*.example
!.env.template
!.env.*.template

# Explicitly keep this local file out of Git
.env.local.example
